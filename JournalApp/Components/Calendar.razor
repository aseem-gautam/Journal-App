@using JournalApp.Services
@using JournalApp.Models
@inject JournalService JournalService
@inject NavigationManager Navigation

<div class="calendar-widget">
    <div class="calendar-header">
        <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousMonth">◀</button>
        <h4>@currentMonth.ToString("MMMM yyyy")</h4>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NextMonth">▶</button>
    </div>

    <div class="calendar-grid">
        <!-- Day headers -->
        <div class="calendar-day-header">Sun</div>
        <div class="calendar-day-header">Mon</div>
        <div class="calendar-day-header">Tue</div>
        <div class="calendar-day-header">Wed</div>
        <div class="calendar-day-header">Thu</div>
        <div class="calendar-day-header">Fri</div>
        <div class="calendar-day-header">Sat</div>

        <!-- Days -->
        @foreach (var day in calendarDays)
        {
            <div class="calendar-day @GetDayClass(day)" @onclick="@(() => OnDayClick(day))">
                @if (day.HasValue)
                {
                    <span>@day.Value.Day</span>
                }
            </div>
        }
    </div>

    <div class="calendar-legend mt-3">
        <div class="legend-item">
            <div class="legend-color" style="background: #4a90e2;"></div>
            <span>Today (No Entry)</span>
        </div>
        <div class="legend-item">
            <div class="legend-color" style="background: #4CAF50;"></div>
            <span>Entry Written</span>
        </div>
        <div class="legend-item">
            <div class="legend-color" style="background: #f8f9fa; opacity: 0.5;"></div>
            <span>No Entry</span>
        </div>
        <div class="legend-item">
            <div class="legend-color" style="background: #e9ecef;"></div>
            <span>Future Days</span>
        </div>
    </div>
</div>


<style>
    :root {
        --calendar-primary: #4a90e2;
        --calendar-primary-hover: #3a80d2;
        --calendar-primary-dark: #2a70c2;
        --calendar-success: #4CAF50;
        --calendar-success-hover: #45a049;
        --calendar-success-dark: #388E3C;
        --calendar-bg-light: #f8f9fa;
        --calendar-bg-medium: #e9ecef;
        --calendar-text-primary: #333;
        --calendar-text-secondary: #666;
        --calendar-text-muted: #999;
        --calendar-border: #eee;
        --calendar-border-medium: #ddd;
        --calendar-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        --calendar-shadow-hover: 0 4px 12px rgba(0, 0, 0, 0.15);
        --calendar-radius: 6px;
        --calendar-radius-large: 10px;
        --calendar-transition: all 0.2s ease-in-out;
    }

    .calendar-widget {
        background: white;
        border-radius: var(--calendar-radius-large);
        padding: 16px;
        box-shadow: var(--calendar-shadow);
        max-width: 600px;
        margin: 0 auto;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        gap: 8px;
    }

        .calendar-header h4 {
            margin: 0;
            color: var(--calendar-text-primary);
            font-size: 1rem;
            font-weight: 600;
            flex: 1;
            text-align: center;
        }

        .calendar-header button {
            min-width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--calendar-transition);
            padding: 0;
            font-size: 0.875rem;
        }

            .calendar-header button:hover {
                transform: scale(1.05);
            }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
        margin-bottom: 12px;
    }

    .calendar-day-header {
        text-align: center;
        font-weight: 600;
        color: var(--calendar-text-secondary);
        padding: 6px 0;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .calendar-day {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--calendar-radius);
        cursor: pointer;
        position: relative;
        transition: var(--calendar-transition);
        border: 2px solid transparent;
        background: var(--calendar-bg-light);
        min-height: 32px;
    }

        .calendar-day span {
            font-size: 0.8rem;
            font-weight: 500;
            line-height: 1;
        }

        /* Interactive states */
        .calendar-day:not(.empty):not(.future):not(.past-no-entry):hover {
            transform: translateY(-2px);
            box-shadow: var(--calendar-shadow-hover);
        }

        .calendar-day:not(.empty):not(.future):not(.past-no-entry):active {
            transform: translateY(0);
        }

        /* Empty days */
        .calendar-day.empty {
            background: transparent;
            cursor: default;
            pointer-events: none;
        }

        /* Past days without entry */
        .calendar-day.past-no-entry {
            background: var(--calendar-bg-light);
            color: var(--calendar-text-muted);
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Past days with entry */
        .calendar-day.past-has-entry {
            background: var(--calendar-success);
            color: white;
            font-weight: 600;
        }

            .calendar-day.past-has-entry:hover {
                background: var(--calendar-success-hover);
            }

        /* Future days */
        .calendar-day.future {
            background: var(--calendar-bg-medium);
            color: var(--calendar-text-secondary);
            cursor: default;
            pointer-events: none;
        }

        /* Today */
        .calendar-day.today {
            background: var(--calendar-primary) !important;
            color: white;
            font-weight: 700;
            border-color: var(--calendar-primary-dark);
            box-shadow: 0 0 0 2px rgba(74, 144, 226, 0.2);
        }

            .calendar-day.today:hover {
                background: var(--calendar-primary-hover) !important;
            }

            .calendar-day.today.has-entry {
                background: var(--calendar-success) !important;
                border-color: var(--calendar-success-dark);
                box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.2);
            }

                .calendar-day.today.has-entry:hover {
                    background: var(--calendar-success-hover) !important;
                }

    /* Legend */
    .calendar-legend {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding-top: 12px;
        border-top: 1px solid var(--calendar-border);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.7rem;
        color: var(--calendar-text-secondary);
    }

    .legend-color {
        width: 14px;
        height: 14px;
        border-radius: 3px;
        border: 1px solid var(--calendar-border-medium);
        flex-shrink: 0;
    }

    .legend-color--today {
        background: var(--calendar-primary);
    }

    .legend-color--entry {
        background: var(--calendar-success);
    }

    .legend-color--no-entry {
        background: var(--calendar-bg-light);
        opacity: 0.5;
    }

    .legend-color--future {
        background: var(--calendar-bg-medium);
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .calendar-widget {
            padding: 12px;
            max-width: 100%;
        }

        .calendar-header h4 {
            font-size: 0.9rem;
        }

        .calendar-grid {
            gap: 3px;
        }

        .calendar-day-header {
            font-size: 0.65rem;
            padding: 4px 0;
        }

        .calendar-day {
            min-height: 28px;
        }

            .calendar-day span {
                font-size: 0.75rem;
            }

        .calendar-legend {
            gap: 8px;
            font-size: 0.65rem;
        }

        .legend-color {
            width: 12px;
            height: 12px;
        }
    }

    @@media (max-width: 480px) {
        .calendar-widget {
            padding: 10px;
        }

        .calendar-header h4 {
            font-size: 0.85rem;
        }

        .calendar-day-header {
            font-size: 0.6rem;
        }

        .calendar-day {
            min-height: 24px;
        }

            .calendar-day span {
                font-size: 0.7rem;
            }

        .calendar-legend {
            gap: 6px;
        }
    }
</style>


@code {
    [Parameter]
    public EventCallback OnEntryClick { get; set; }

    private DateTime currentMonth = DateTime.Today;
    private List<DateTime?> calendarDays = new();
    private HashSet<DateTime> datesWithEntries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCalendar();
    }

    private async Task LoadCalendar()
    {
        // Get all entries for the current month
        var startOfMonth = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var endOfMonth = startOfMonth.AddMonths(1).AddDays(-1);

        var entries = await JournalService.GetEntriesByDateRangeAsync(startOfMonth, endOfMonth);
        datesWithEntries = entries.Select(e => e.Date.Date).ToHashSet();

        // Build calendar grid
        GenerateCalendarDays();
    }

    private void GenerateCalendarDays()
    {
        calendarDays.Clear();

        var firstDayOfMonth = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

        // Add empty days before the first day of month
        int startDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
        for (int i = 0; i < startDayOfWeek; i++)
        {
            calendarDays.Add(null);
        }

        // Add all days of the month
        for (int day = 1; day <= lastDayOfMonth.Day; day++)
        {
            calendarDays.Add(new DateTime(currentMonth.Year, currentMonth.Month, day));
        }

        // Fill remaining slots to complete the grid
        while (calendarDays.Count % 7 != 0)
        {
            calendarDays.Add(null);
        }
    }

    private async Task PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        await LoadCalendar();
    }

    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        await LoadCalendar();
    }

    private string GetDayClass(DateTime? day)
    {
        if (!day.HasValue) return "empty";

        var classes = new List<string>();
        var today = DateTime.Today;

        // Check if it's today
        if (day.Value.Date == today)
        {
            classes.Add("today");

            // If today has an entry, add has-entry class
            if (HasEntry(day.Value))
            {
                classes.Add("has-entry");
            }
        }
        // Check if it's a past date (before today)
        else if (day.Value.Date < today)
        {
            if (HasEntry(day.Value))
            {
                classes.Add("past-has-entry");
            }
            else
            {
                classes.Add("past-no-entry");
            }
        }
        // Future dates
        else
        {
            classes.Add("future");
        }

        return string.Join(" ", classes);
    }

    private bool HasEntry(DateTime day)
    {
        return datesWithEntries.Contains(day.Date);
    }

    private void OnDayClick(DateTime? day)
    {
        if (!day.HasValue) return;

        var today = DateTime.Today;

        // For today: Navigate to create page
        if (day.Value.Date == today)
        {
            Navigation.NavigateTo($"/create?date={day.Value:yyyy-MM-dd}");
        }
        // For past days with entries: Navigate to journals page with that date
        else if (day.Value.Date < today && HasEntry(day.Value))
        {
            Navigation.NavigateTo($"/journals?date={day.Value:yyyy-MM-dd}");
        }
        // else: do nothing (past without entry or future)
    }
}