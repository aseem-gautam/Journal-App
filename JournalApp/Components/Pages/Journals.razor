        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 20px 24px;
        border-top: 1px solid #eee;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? date { get; set; }

    private List<JournalEntry> entries = new();
    private JournalEntry? selectedEntry = null;
    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private string sortOrder = "newest";

    private int currentPage = 1;
    private int pageSize = 9;
    private int totalPages = 1;
    private int totalEntries = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!SecurityService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadEntries();

        // If navigated from calendar with a specific date, open that entry
        if (!string.IsNullOrEmpty(date) && DateTime.TryParse(date, out var selectedDate))
        {
            var entry = await JournalService.GetEntryByDateAsync(selectedDate);
            if (entry != null)
            {
                selectedEntry = entry;
            }
        }
    }

    private async Task LoadEntries()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            totalEntries = await JournalService.GetTotalEntriesCountAsync();
            totalPages = (int)Math.Ceiling((double)totalEntries / pageSize);

            if (string.IsNullOrWhiteSpace(searchQuery))
            {
                entries = await JournalService.GetEntriesAsync(currentPage, pageSize);
            }
            else
            {
                entries = await JournalService.SearchEntriesAsync(searchQuery);
                // Apply pagination to search results
                entries = entries.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
            }

            // Apply sorting
            if (sortOrder == "oldest")
            {
                entries = entries.OrderBy(e => e.Date).ToList();
            }
            else
            {
                entries = entries.OrderByDescending(e => e.Date).ToList();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading entries: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchEntries()
    {
        currentPage = 1;
        await LoadEntries();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadEntries();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadEntries();
        }
    }

    private void ShowEntryDetail(JournalEntry entry)
    {
        selectedEntry = entry;
    }

    private void CloseModal()
    {
        selectedEntry = null;
    }

    private string GetPreviewText(string content)
    {
        // Remove HTML tags and get plain text preview
        var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", string.Empty);
        plainText = plainText.Trim();

        if (plainText.Length > 150)
        {
            return plainText.Substring(0, 150) + "...";
        }

        return plainText;
    }

    private string GetRenderedContent(string content)
    {
        try
        {
            // Render HTML content (from Quill editor)
            return content;
        }
        catch
        {
            return content;
        }
    }
}