@code {
    [SupplyParameterFromQuery]
    public string? date { get; set; }

    private List<JournalEntry> entries = new();
    private List<JournalEntry> allFilteredEntries = new();
    private JournalEntry? selectedEntry = null;
    private bool isLoading = true;
    private bool showAdvancedFilters = false;

    // Search and Filter
    private string searchQuery = string.Empty;
    private string sortOrder = "newest";
    private DateTime? filterStartDate = null;
    private DateTime? filterEndDate = null;
    private string selectedMoodFilter = string.Empty;
    private string selectedTagFilter = string.Empty;

    // Moods and Tags for filters
    private List<Mood> allMoods = new();
    private List<Tag> allTags = new();

    // Pagination
    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages = 1;
    private int totalEntries = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!SecurityService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Load moods and tags for filters
        allMoods = await MoodService.GetAllMoodsAsync();
        allTags = await TagService.GetAllTagsAsync();

        await ApplyFilters();

        // If navigated from calendar with a specific date, open that entry
        if (!string.IsNullOrEmpty(date) && DateTime.TryParse(date, out var selectedDate))
        {
            var entry = await JournalService.GetEntryByDateAsync(selectedDate);
            if (entry != null)
            {
                selectedEntry = entry;
            }
        }
    }

    private void ToggleAdvancedFilters()
    {
        showAdvancedFilters = !showAdvancedFilters;
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(searchQuery) ||
               filterStartDate.HasValue ||
               filterEndDate.HasValue ||
               !string.IsNullOrEmpty(selectedMoodFilter) ||
               !string.IsNullOrEmpty(selectedTagFilter);
    }

    private async Task ClearFilters()
    {
        searchQuery = string.Empty;
        filterStartDate = null;
        filterEndDate = null;
        selectedMoodFilter = string.Empty;
        selectedTagFilter = string.Empty;
        sortOrder = "newest";
        currentPage = 1;
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        currentPage = 1;
        StateHasChanged();

        try
        {
            // Start with all entries
            allFilteredEntries = new List<JournalEntry>();

            // Apply search
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                allFilteredEntries = await JournalService.SearchEntriesAsync(searchQuery);
            }
            else
            {
                // Get all entries
                var totalCount = await JournalService.GetTotalEntriesCountAsync();
                allFilteredEntries = await JournalService.GetEntriesAsync(1, totalCount);
            }

            // Apply date range filter
            if (filterStartDate.HasValue || filterEndDate.HasValue)
            {
                var start = filterStartDate ?? DateTime.MinValue;
                var end = filterEndDate ?? DateTime.MaxValue;
                allFilteredEntries = allFilteredEntries
                    .Where(e => e.Date.Date >= start.Date && e.Date.Date <= end.Date)
                    .ToList();
            }

            // Apply mood filter
            if (!string.IsNullOrEmpty(selectedMoodFilter) && int.TryParse(selectedMoodFilter, out int moodId))
            {
                allFilteredEntries = allFilteredEntries
                    .Where(e => e.PrimaryMoodId == moodId || e.SecondaryMoods.Any(sm => sm.MoodId == moodId))
                    .ToList();
            }

            // Apply tag filter
            if (!string.IsNullOrEmpty(selectedTagFilter) && int.TryParse(selectedTagFilter, out int tagId))
            {
                allFilteredEntries = allFilteredEntries
                    .Where(e => e.Tags.Any(t => t.TagId == tagId))
                    .ToList();
            }

            // Apply sorting
            if (sortOrder == "oldest")
            {
                allFilteredEntries = allFilteredEntries.OrderBy(e => e.Date).ToList();
            }
            else
            {
                allFilteredEntries = allFilteredEntries.OrderByDescending(e => e.Date).ToList();
            }

            // Calculate pagination
            totalEntries = allFilteredEntries.Count;
            totalPages = (int)Math.Ceiling((double)totalEntries / pageSize);

            // Get current page entries
            entries = allFilteredEntries
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error applying filters: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            entries = allFilteredEntries
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
            StateHasChanged();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            entries = allFilteredEntries
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
            StateHasChanged();
        }
    }

    private void ShowEntryDetail(JournalEntry entry)
    {
        selectedEntry = entry;
    }

    private void CloseModal()
    {
        selectedEntry = null;
    }

    private string GetPreviewText(string content)
    {
        // Remove HTML tags and get plain text preview
        var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", string.Empty);
        plainText = plainText.Trim();

        if (plainText.Length > 150)
        {
            return plainText.Substring(0, 150) + "...";
        }

        return plainText;
    }

    private string GetRenderedContent(string content)
    {
        try
        {
            // Render HTML content (from Quill editor)
            return content;
        }
        catch
        {
            return content;
        }
    }
}