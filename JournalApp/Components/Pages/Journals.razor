@page "/journals"
@using JournalApp.Services
@using JournalApp.Models
@using JournalApp.Components
@inject JournalService JournalService
@inject MoodService MoodService
@inject TagService TagService
@inject NavigationManager Navigation
@inject SecurityService SecurityService

<div class="journals-container">
    <h2>📚 My Journals</h2>

    <!-- Search and Filter Section -->
    <div class="filter-section mb-4">
        <div class="row mb-3">
            <div class="col-md-12">
                <input type="text" class="form-control" @bind="searchQuery" @bind:after="ApplyFilters"
                       placeholder="🔍 Search by title or content..." />
            </div>
        </div>

        <!-- Advanced Filters -->
        <div class="advanced-filters">
            <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="ToggleAdvancedFilters">
                @(showAdvancedFilters ? "Hide" : "Show") Advanced Filters
            </button>

            @if (showAdvancedFilters)
            {
                <div class="row">
                    <!-- Date Range Filter -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date Range</label>
                        <div class="d-flex gap-2">
                            <input type="date" class="form-control" @bind="filterStartDate" @bind:after="ApplyFilters" />
                            <span class="align-self-center">to</span>
                            <input type="date" class="form-control" @bind="filterEndDate" @bind:after="ApplyFilters" />
                        </div>
                    </div>

                    <!-- Sort Order -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Sort By</label>
                        <select class="form-control" @bind="sortOrder" @bind:after="ApplyFilters">
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                        </select>
                    </div>

                    <!-- Mood Filter -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Filter by Mood</label>
                        <select class="form-control" @bind="selectedMoodFilter" @bind:after="ApplyFilters">
                            <option value="">All Moods</option>
                            @foreach (var mood in allMoods)
                            {
                                <option value="@mood.Id">@mood.Icon @mood.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Tag Filter -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Filter by Tag</label>
                        <select class="form-control" @bind="selectedTagFilter" @bind:after="ApplyFilters">
                            <option value="">All Tags</option>
                            @foreach (var tag in allTags)
                            {
                                <option value="@tag.Id">#@tag.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Clear Filters Button -->
                <div class="row">
                    <div class="col-12">
                        <button class="btn btn-outline-danger btn-sm" @onclick="ClearFilters">
                            Clear All Filters
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Active Filters Display -->
        @if (HasActiveFilters())
        {
            <div class="active-filters mt-3">
                <strong>Active Filters:</strong>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <span class="filter-badge">Search: "@searchQuery" <button @onclick="@(() => { searchQuery = string.Empty; ApplyFilters(); })">×</button></span>
                }
                @if (filterStartDate.HasValue || filterEndDate.HasValue)
                {
                    <span class="filter-badge">
                        Date: @(filterStartDate?.ToString("MMM dd, yyyy") ?? "Start") - @(filterEndDate?.ToString("MMM dd, yyyy") ?? "End")
                        <button @onclick="@(() => { filterStartDate = null; filterEndDate = null; ApplyFilters(); })">×</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(selectedMoodFilter))
                {
                    var mood = allMoods.FirstOrDefault(m => m.Id.ToString() == selectedMoodFilter);
                    <span class="filter-badge">
                        Mood: @mood?.Icon @mood?.Name
                        <button @onclick="@(() => { selectedMoodFilter = string.Empty; ApplyFilters(); })">×</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(selectedTagFilter))
                {
                    var tag = allTags.FirstOrDefault(t => t.Id.ToString() == selectedTagFilter);
                    <span class="filter-badge">
                        Tag: #@tag?.Name
                        <button @onclick="@(() => { selectedTagFilter = string.Empty; ApplyFilters(); })">×</button>
                    </span>
                }
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!entries.Any())
    {
        <div class="empty-state">
            <div class="empty-state__icon">📝</div>
            <h3>No entries found</h3>
            <p class="text-muted">
                @(HasActiveFilters() ? "Try adjusting your filters or search criteria." : "Start writing your first journal entry!")
            </p>
            @if (!HasActiveFilters())
            {
                <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/create"))">Write Entry</button>
            }
        </div>
    }
    else
    {
        <!-- Results Count -->
        <div class="results-info mb-3">
            <p class="text-muted">Showing @entries.Count of @totalEntries entries</p>
        </div>

        <!-- Entries List -->
        <div class="entries-grid">
            @foreach (var entry in entries)
            {
                <div class="entry-card" @onclick="@(() => ShowEntryDetail(entry))">
                    <div class="entry-header">
                        <h4 class="entry-title">@entry.Title</h4>
                        <span class="entry-date">@entry.Date.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="entry-mood">
                        <span class="mood-badge" style="background-color: @entry.PrimaryMood.Color">
                            @entry.PrimaryMood.Icon @entry.PrimaryMood.Name
                        </span>
                        @foreach (var secondaryMood in entry.SecondaryMoods.Take(2))
                        {
                            <span class="mood-badge-small">@secondaryMood.Mood.Icon</span>
                        }
                    </div>
                    <div class="entry-preview">
                        @GetPreviewText(entry.Content)
                    </div>
                    <div class="entry-footer">
                        <span class="word-count">@entry.WordCount words</span>
                        @if (entry.Tags.Any())
                        {
                            <div class="entry-tags">
                                @foreach (var tag in entry.Tags.Take(3))
                                {
                                    <span class="tag-mini">#@tag.Tag.Name</span>
                                }
                                @if (entry.Tags.Count > 3)
                                {
                                    <span class="tag-mini">+@(entry.Tags.Count - 3)</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <div class="pagination-controls">
            <button class="btn btn-outline-secondary" @onclick="PreviousPage" disabled="@(currentPage <= 1)">
                ◀ Previous
            </button>
            <span class="page-info">Page @currentPage of @totalPages</span>
            <button class="btn btn-outline-secondary" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                Next ▶
            </button>
        </div>
    }
</div>

<!-- Modal for viewing entry details -->
@if (selectedEntry != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@selectedEntry.Title</h3>
                <button class="btn-close-modal" @onclick="CloseModal">✕</button>
            </div>

            <div class="modal-body">
                <div class="entry-meta">
                    <span class="meta-item">📅 @selectedEntry.Date.ToString("dddd, MMMM dd, yyyy")</span>
                    <span class="meta-item">📝 @selectedEntry.WordCount words</span>
                    <span class="meta-item">⏰ Created @selectedEntry.CreatedAt.ToString("h:mm tt")</span>
                </div>

                <div class="mood-section">
                    <strong>Mood:</strong>
                    <span class="mood-badge" style="background-color: @selectedEntry.PrimaryMood.Color">
                        @selectedEntry.PrimaryMood.Icon @selectedEntry.PrimaryMood.Name
                    </span>
                    @foreach (var secondaryMood in selectedEntry.SecondaryMoods)
                    {
                        <span class="mood-badge" style="background-color: @secondaryMood.Mood.Color">
                            @secondaryMood.Mood.Icon @secondaryMood.Mood.Name
                        </span>
                    }
                </div>

                @if (selectedEntry.Tags.Any())
                {
                    <div class="tags-section">
                        <strong>Tags:</strong>
                        @foreach (var tag in selectedEntry.Tags)
                        {
                            <span class="tag-badge">#@tag.Tag.Name</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(selectedEntry.Category))
                {
                    <div class="category-section">
                        <strong>Category:</strong> @selectedEntry.Category
                    </div>
                }

                <div class="content-section">
                    @((MarkupString)GetRenderedContent(selectedEntry.Content))
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo($"/create?date={selectedEntry.Date:yyyy-MM-dd}"))">
                    ✏️ Edit Entry
                </button>
                <button class="btn btn-secondary" @onclick="CloseModal">Close</button>
            </div>
        </div>
    </div>
}

<style>
    :root {
        --color-primary: #4a90e2;
        --color-secondary: #6c757d;
        --color-danger: #dc3545;
        --color-text-primary: #2c3e50;
        --color-text-secondary: #6c757d;
        --color-text-muted: #95a5a6;
        --color-bg-light: #f8f9fa;
        --color-bg-white: #ffffff;
        --color-border: #dee2e6;
        --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.15);
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 12px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .journals-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 32px 24px;
        background: var(--color-bg-light);
        min-height: 100vh;
    }

        .journals-container h2 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-text-primary);
            margin-bottom: 32px;
            text-align: center;
        }

    /* Filter Section */
    .filter-section {
        background: var(--color-bg-white);
        padding: 24px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        margin-bottom: 32px;
    }

    .mb-3 {
        margin-bottom: 1rem;
    }

    .mb-4 {
        margin-bottom: 1.5rem;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        font-size: 1rem;
        transition: var(--transition);
    }

        .form-control:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1);
        }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--color-text-primary);
        margin-bottom: 8px;
        font-size: 0.875rem;
    }

    .advanced-filters {
        padding-top: 20px;
        margin-top: 20px;
        border-top: 1px solid var(--color-border);
    }

    .row {
        display: grid;
        gap: 16px;
    }

    .col-md-12 {
        grid-column: 1 / -1;
    }

    .col-md-6 {
        grid-column: span 1;
    }

    @@media (min-width: 768px) {
        .row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .d-flex {
        display: flex;
    }

    .gap-2 {
        gap: 8px;
    }

    .align-self-center {
        align-self: center;
    }

    /* Active Filters */
    .active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        padding: 16px;
        background: #e8eaf6;
        border-radius: var(--radius-md);
        margin-top: 16px;
    }

        .active-filters strong {
            color: var(--color-text-primary);
            font-size: 0.875rem;
        }

    .filter-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background: var(--color-primary);
        color: white;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 500;
    }

        .filter-badge button {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            padding: 0;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: var(--transition);
            line-height: 1;
        }

            .filter-badge button:hover {
                background: rgba(255, 255, 255, 0.3);
                transform: scale(1.1);
            }

    /* Results Info */
    .results-info {
        text-align: center;
        margin-bottom: 24px;
    }

        .results-info p {
            margin: 0;
            color: var(--color-text-muted);
            font-size: 0.9rem;
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: var(--color-bg-white);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    .empty-state__icon {
        font-size: 5rem;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .empty-state h3 {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--color-text-primary);
        margin-bottom: 12px;
    }

    .empty-state .text-muted {
        font-size: 1.125rem;
        color: var(--color-text-muted);
        margin-bottom: 24px;
    }

    /* Entries Grid */
    .entries-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 40px;
    }

    @@media (max-width: 1200px) {
        .entries-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .entries-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Entry Card */
    .entry-card {
        background: var(--color-bg-white);
        border-radius: var(--radius-lg);
        padding: 24px;
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        transition: var(--transition);
        border: 2px solid transparent;
        display: flex;
        flex-direction: column;
    }

        .entry-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-color: var(--color-primary);
        }

    .entry-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
        gap: 12px;
    }

    .entry-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-text-primary);
        margin: 0;
        flex: 1;
        line-height: 1.3;
    }

    .entry-date {
        font-size: 0.8125rem;
        color: var(--color-text-secondary);
        white-space: nowrap;
        font-weight: 500;
    }

    .entry-mood {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
        align-items: center;
    }

    .mood-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .mood-badge-small {
        font-size: 1.25rem;
        line-height: 1;
    }

    .entry-preview {
        color: var(--color-text-secondary);
        font-size: 0.9375rem;
        line-height: 1.6;
        margin-bottom: 16px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        flex: 1;
    }

    .entry-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 1px solid var(--color-border);
        gap: 12px;
    }

    .word-count {
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        font-weight: 500;
    }

    .entry-tags {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .tag-mini {
        font-size: 0.75rem;
        color: var(--color-primary);
        background: #e8eaf6;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 600;
    }

    /* Pagination */
    .pagination-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 24px;
        margin-top: 40px;
    }

    .page-info {
        font-weight: 600;
        color: var(--color-text-secondary);
        font-size: 0.9375rem;
    }

    /* Buttons */
    .btn {
        padding: 10px 24px;
        font-weight: 600;
        border-radius: var(--radius-sm);
        transition: var(--transition);
        border: none;
        cursor: pointer;
        font-size: 0.9375rem;
    }

    .btn-primary {
        background: var(--color-primary);
        color: white;
    }

        .btn-primary:hover:not(:disabled) {
            background: #357abd;
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .btn-secondary {
        background: var(--color-secondary);
        color: white;
    }

        .btn-secondary:hover:not(:disabled) {
            background: #5a6268;
        }

    .btn-outline-secondary {
        background: transparent;
        color: var(--color-secondary);
        border: 2px solid var(--color-secondary);
    }

        .btn-outline-secondary:hover:not(:disabled) {
            background: var(--color-secondary);
            color: white;
        }

    .btn-outline-danger {
        background: transparent;
        color: var(--color-danger);
        border: 2px solid var(--color-danger);
    }

        .btn-outline-danger:hover:not(:disabled) {
            background: var(--color-danger);
            color: white;
        }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-sm {
        padding: 6px 16px;
        font-size: 0.875rem;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.75);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

    .modal-content {
        background: var(--color-bg-white);
        border-radius: var(--radius-lg);
        max-width: 900px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        animation: modalSlideIn 0.3s ease-out;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-50px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 28px 32px;
        border-bottom: 1px solid var(--color-border);
    }

        .modal-header h3 {
            margin: 0;
            color: var(--color-text-primary);
            font-size: 1.75rem;
            font-weight: 700;
        }

    .btn-close-modal {
        background: none;
        border: none;
        font-size: 32px;
        cursor: pointer;
        color: var(--color-text-muted);
        padding: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: var(--transition);
        line-height: 1;
    }

        .btn-close-modal:hover {
            background: var(--color-bg-light);
            color: var(--color-text-primary);
            transform: rotate(90deg);
        }

    .modal-body {
        padding: 32px;
    }

    .entry-meta {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--color-border);
    }

    .meta-item {
        font-size: 0.9375rem;
        color: var(--color-text-secondary);
        font-weight: 500;
    }

    .mood-section,
    .tags-section,
    .category-section {
        margin-bottom: 24px;
    }

        .mood-section strong,
        .tags-section strong,
        .category-section strong {
            display: block;
            margin-bottom: 12px;
            color: var(--color-text-primary);
            font-weight: 600;
            font-size: 0.9375rem;
        }

    .tag-badge {
        display: inline-block;
        padding: 6px 14px;
        background: #e8eaf6;
        color: var(--color-primary);
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-right: 8px;
        margin-bottom: 8px;
    }

    .content-section {
        margin-top: 32px;
        padding-top: 32px;
        border-top: 2px solid var(--color-border);
        line-height: 1.8;
        color: var(--color-text-primary);
        font-size: 1rem;
    }

        .content-section h1,
        .content-section h2,
        .content-section h3 {
            margin-top: 28px;
            margin-bottom: 14px;
            font-weight: 600;
        }

        .content-section p {
            margin-bottom: 18px;
        }

        .content-section ul,
        .content-section ol {
            margin-bottom: 18px;
            padding-left: 32px;
        }

        .content-section blockquote {
            border-left: 4px solid var(--color-primary);
            padding-left: 24px;
            margin: 24px 0;
            color: var(--color-text-secondary);
            font-style: italic;
        }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 24px 32px;
        border-top: 1px solid var(--color-border);
        background: var(--color-bg-light);
    }

    /* Spinner */
    .text-center {
        text-align: center;
    }

    .my-5 {
        margin-top: 3rem;
        margin-bottom: 3rem;
    }

    .spinner-border {
        display: inline-block;
        width: 3rem;
        height: 3rem;
        border: 4px solid var(--color-primary);
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border 0.75s linear infinite;
    }

    @@keyframes spinner-border {
        to {
            transform: rotate(360deg);
        }
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .journals-container {
            padding: 20px 16px;
        }

            .journals-container h2 {
                font-size: 1.5rem;
            }

        .filter-section {
            padding: 20px;
        }

        .modal-content {
            max-height: 95vh;
        }

        .modal-header {
            padding: 20px;
