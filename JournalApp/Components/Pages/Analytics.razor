@page "/analytics"
@using JournalApp.Services
@using JournalApp.Models
@inject AnalyticsService AnalyticsService
@inject StreakService StreakService
@inject ExportService ExportService
@inject NavigationManager Navigation
@inject SecurityService SecurityService
@inject IJSRuntime JSRuntime

<div class="analytics-page">
    <div class="page-header">
        <h1>📊 Journal Analytics</h1>
        <p class="subtitle">Insights into your journaling journey</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading analytics...</p>
        </div>
    }
    else
    {
        <!-- Streak Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">🔥</div>
                <div class="stat-content">
                    <h3>@streakInfo.CurrentStreak</h3>
                    <p>Current Streak</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">🏆</div>
                <div class="stat-content">
                    <h3>@streakInfo.LongestStreak</h3>
                    <p>Longest Streak</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">📝</div>
                <div class="stat-content">
                    <h3>@streakInfo.TotalEntries</h3>
                    <p>Total Entries</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">❌</div>
                <div class="stat-content">
                    <h3>@streakInfo.MissedDays.Count</h3>
                    <p>Missed Days</p>
                </div>
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="charts-container">
            <!-- Mood Distribution -->
            <div class="chart-card">
                <div class="card-header">
                    <h3>😊 Mood Distribution</h3>
                    <p>How you've been feeling</p>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-wrapper--pie">
                        <canvas id="moodDistributionChart"></canvas>
                    </div>
                    <div class="mood-stats-list">
                        @foreach (var mood in moodDistribution)
                        {
                            <div class="stat-item">
                                <span class="label">@mood.Category</span>
                                <span class="value">@mood.Count (@mood.Percentage%)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Frequent Moods -->
            <div class="chart-card">
                <div class="card-header">
                    <h3>🎯 Most Frequent Moods</h3>
                    <p>Your top emotional states</p>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-wrapper--bar">
                        <canvas id="frequentMoodsChart"></canvas>
                    </div>
                    <div class="mood-list">
                        @foreach (var mood in frequentMoods)
                        {
                            <div class="mood-item">
                                <span class="emoji">@mood.Icon</span>
                                <span class="name">@mood.MoodName</span>
                                <span class="count">@mood.Count times</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Most Used Tags -->
            <div class="chart-card">
                <div class="card-header">
                    <h3>🏷️ Most Used Tags</h3>
                    <p>Your journaling themes</p>
                </div>
                <div class="card-body card-body--content-only">
                    <div class="tag-cloud">
                        @if (mostUsedTags.Any())
                        {
                            @foreach (var tag in mostUsedTags)
                            {
                                <span class="tag-item" style="font-size: @(0.875 + tag.Count * 0.125)rem;">
                                    #@tag.TagName
                                </span>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No tags yet. Start tagging your entries!</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Word Count -->
            <div class="chart-card">
                <div class="card-header">
                    <h3>📈 Word Count Trends</h3>
                    <p>Your writing journey</p>
                </div>
                <div class="card-body card-body--content-only">
                    <div class="word-stats-grid">
                        <div class="word-stat">
                            <div class="number">@averageWordCount</div>
                            <div class="label">Avg Words/Entry</div>
                        </div>
                        <div class="word-stat">
                            <div class="number">@totalWords</div>
                            <div class="label">Total Words</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Export Section -->
            <div class="chart-card full-width">
                <div class="card-header">
                    <h3>📤 Export Journal Data</h3>
                    <p>Download your entries in various formats</p>
                </div>
                <div class="card-body">
                    <div class="export-container">
                        <!-- Date Range Selection -->
                        <div class="date-range-selector">
                            <div class="date-input-group">
                                <label>From Date</label>
                                <input type="date" class="form-control" @bind="startDate" />
                            </div>
                            <div class="date-input-group">
                                <label>To Date</label>
                                <input type="date" class="form-control" @bind="endDate" />
                            </div>
                            <button class="btn-reset" @onclick="ResetDateRange">Reset to All Time</button>
                        </div>

                        @if (!string.IsNullOrEmpty(exportMessage))
                        {
                            <div class="export-message @(exportMessage.Contains("✅") ? "success" : exportMessage.Contains("⚠️") ? "warning" : "error")">
                                @exportMessage
                            </div>
                        }

                        <!-- Export Button -->
                        <div class="export-buttons">
                            <button class="export-btn" @onclick="@(() => ExportData("pdf"))" disabled="@isExporting">
                                <span class="btn-icon">📄</span>
                                <div class="btn-content">
                                    <span class="btn-text">@(isExporting ? "Exporting..." : "Export as PDF")</span>
                                    <span class="btn-description">Download your journal entries as a formatted PDF document</span>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --color-primary: #4a90e2;
        --color-primary-dark: #357abd;
        --color-success: #4CAF50;
        --color-warning: #ff9800;
        --color-danger: #dc3545;
        --color-text-primary: #2c3e50;
        --color-text-secondary: #6c757d;
        --color-text-muted: #95a5a6;
        --color-bg-light: #f8f9fa;
        --color-bg-white: #ffffff;
        --color-border: #dee2e6;
        --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.15);
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 12px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .analytics-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 32px 24px;
        background: var(--color-bg-light);
        min-height: 100vh;
    }

    .page-header {
        text-align: center;
        margin-bottom: 32px;
    }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-text-primary);
            margin-bottom: 4px;
        }

    .subtitle {
        font-size: 1rem;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .loading-state {
        text-align: center;
        padding: 100px 20px;
    }

        .loading-state p {
            color: var(--color-text-secondary);
            margin-top: 16px;
        }

    .spinner-border {
        display: inline-block;
        width: 3rem;
        height: 3rem;
        border: 4px solid var(--color-primary);
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border 0.75s linear infinite;
    }

    @@keyframes spinner-border {
        to {
            transform: rotate(360deg);
        }
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-card {
        background: var(--color-bg-white);
        border-radius: var(--radius-lg);
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        border: 2px solid transparent;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: var(--color-primary);
        }

    .stat-icon {
        font-size: 2.5rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .stat-content {
        flex: 1;
    }

        .stat-content h3 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-success);
            margin: 0;
            line-height: 1;
        }

        .stat-content p {
            margin: 6px 0 0 0;
            color: var(--color-text-secondary);
            font-size: 0.8125rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

    /* Charts Container */
    .charts-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .chart-card {
        background: var(--color-bg-white);
        border-radius: var(--radius-lg);
        padding: 24px;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        display: flex;
        flex-direction: column;
    }

        .chart-card:hover {
            box-shadow: var(--shadow-md);
        }

        .chart-card.full-width {
            grid-column: 1 / -1;
        }

    .card-header {
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--color-border);
        flex-shrink: 0;
    }

        .card-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            margin: 0 0 2px 0;
            color: var(--color-text-primary);
        }

        .card-header p {
            margin: 0;
            color: var(--color-text-muted);
            font-size: 0.8125rem;
        }

    /* Card Body */
    .card-body {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    /* Card body for content only (no charts) */
    .card-body--content-only {
        justify-content: center;
        align-items: center;
        min-height: 320px;
    }

    /* Chart Wrappers */
    .chart-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        margin-bottom: 16px;
        flex-shrink: 0;
    }

    /* Pie chart */
    .chart-wrapper--pie {
        height: 280px;
    }

        .chart-wrapper--pie canvas {
            max-height: 280px !important;
            max-width: 280px !important;
        }

    /* Bar charts */
    .chart-wrapper--bar {
        height: 280px;
    }

        .chart-wrapper--bar canvas {
            max-height: 280px !important;
            width: 100% !important;
        }

    /* Mood Stats List */
    .mood-stats-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex-shrink: 0;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        background: var(--color-bg-light);
        border-radius: var(--radius-sm);
        transition: var(--transition);
    }

        .stat-item:hover {
            background: #e8eaf6;
        }

        .stat-item .label {
            font-weight: 600;
            color: var(--color-text-primary);
            font-size: 0.875rem;
        }

        .stat-item .value {
            color: var(--color-primary);
            font-weight: 700;
            font-size: 0.875rem;
        }

    /* Mood List */
    .mood-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex-shrink: 0;
    }

    .mood-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: var(--color-bg-light);
        border-radius: var(--radius-sm);
        transition: var(--transition);
    }

        .mood-item:hover {
            background: #e8eaf6;
            transform: translateX(4px);
        }

        .mood-item .emoji {
            font-size: 1.5rem;
            line-height: 1;
        }

        .mood-item .name {
            font-weight: 600;
            flex: 1;
            color: var(--color-text-primary);
            font-size: 0.875rem;
        }

        .mood-item .count {
            color: var(--color-primary);
            font-size: 0.8125rem;
            font-weight: 600;
        }

    /* Tag Cloud - NO CHART */
    .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
        padding: 32px;
        background: var(--color-bg-light);
        border-radius: var(--radius-md);
        align-items: center;
        width: 100%;
    }

    .tag-item {
        color: var(--color-primary);
        font-weight: 600;
        transition: var(--transition);
        cursor: default;
    }

        .tag-item:hover {
            transform: scale(1.1);
            color: var(--color-primary-dark);
        }

    /* Word Stats - NO CHART */
    .word-stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        width: 100%;
    }

    .word-stat {
        text-align: center;
        padding: 36px 24px;
        background: linear-gradient(135deg, var(--color-primary) 0%, #357abd 100%);
        border-radius: var(--radius-md);
        color: white;
        box-shadow: var(--shadow-md);
        transition: var(--transition);
    }

        .word-stat:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        .word-stat .number {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 8px;
            line-height: 1;
        }

        .word-stat .label {
            font-size: 0.875rem;
            opacity: 0.95;
            font-weight: 500;
        }

    /* Export Section */
    .export-container {
        background: linear-gradient(135deg, var(--color-primary) 0%, #357abd 100%);
        padding: 24px;
        border-radius: var(--radius-md);
    }

    .date-range-selector {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 12px;
        margin-bottom: 16px;
        align-items: end;
    }

    .date-input-group {
        display: flex;
        flex-direction: column;
    }

        .date-input-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            font-size: 0.8125rem;
            color: white;
        }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        transition: var(--transition);
        background: rgba(255, 255, 255, 0.9);
    }

        .form-control:focus {
            outline: none;
            border-color: white;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.2);
            background: white;
        }

    .btn-reset {
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid white;
        color: white;
        border-radius: var(--radius-sm);
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        white-space: nowrap;
        font-size: 0.875rem;
        height: fit-content;
    }

        .btn-reset:hover {
            background: white;
            color: var(--color-primary);
            transform: translateY(-2px);
        }

    .export-message {
        padding: 12px 16px;
        border-radius: var(--radius-sm);
        margin-bottom: 16px;
        font-weight: 500;
        font-size: 0.875rem;
    }

        .export-message.success {
            background: rgba(76, 175, 80, 0.2);
            border: 2px solid rgba(76, 175, 80, 0.6);
            color: white;
        }

        .export-message.warning {
            background: rgba(255, 193, 7, 0.2);
            border: 2px solid rgba(255, 193, 7, 0.6);
            color: white;
        }

        .export-message.error {
            background: rgba(244, 67, 54, 0.2);
            border: 2px solid rgba(244, 67, 54, 0.6);
            color: white;
        }

    .export-buttons {
        display: flex;
        justify-content: center;
    }

    .export-btn {
        padding: 20px 24px;
        border: 2px solid white;
        background: rgba(255, 255, 255, 0.15);
        color: white;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 16px;
        font-weight: 600;
        max-width: 500px;
        width: 100%;
    }

        .export-btn:hover:not(:disabled) {
            background: white;
            color: var(--color-primary);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .export-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .export-btn .btn-icon {
            font-size: 2rem;
            line-height: 1;
            flex-shrink: 0;
        }

    .btn-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        flex: 1;
    }

    .export-btn .btn-text {
        font-size: 1rem;
        font-weight: 700;
    }

    .btn-description {
        font-size: 0.8125rem;
        opacity: 0.9;
        font-weight: 400;
        line-height: 1.3;
    }

    .text-muted {
        color: var(--color-text-muted);
        font-size: 1rem;
        margin: 0;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .charts-container {
            grid-template-columns: 1fr;
        }

        .chart-card.full-width {
            grid-column: 1;
        }
    }

    @@media (max-width: 768px) {
        .analytics-page {
            padding: 20px 16px;
        }

        .page-header h1 {
            font-size: 1.5rem;
        }

        .subtitle {
            font-size: 0.9375rem;
        }

        .stats-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .stat-card {
            padding: 20px;
        }

        .stat-content h3 {
            font-size: 1.75rem;
        }

        .chart-card {
            padding: 20px;
        }

        .date-range-selector {
            grid-template-columns: 1fr;
        }

        .word-stats-grid {
            grid-template-columns: 1fr;
        }

        .export-btn {
            flex-direction: column;
            text-align: center;
        }

        .btn-content {
            align-items: center;
        }

        .tag-cloud {
            padding: 20px;
        }

        .word-stat {
            padding: 28px 20px;
        }
    }

    @@media (max-width: 480px) {
        .stat-icon {
            font-size: 2rem;
        }

        .stat-content h3 {
            font-size: 1.5rem;
        }

        .word-stat .number {
            font-size: 2.5rem;
        }
    }
</style>

@code {
    private DateTime? startDate = null;
    private DateTime? endDate = null;
    private bool isLoading = true;
    private bool isExporting = false;
    private string exportMessage = string.Empty;

    private StreakInfo streakInfo = new();
    private List<MoodDistribution> moodDistribution = new();
    private List<MoodFrequency> frequentMoods = new();
    private List<TagUsage> mostUsedTags = new();
    private List<WordCountTrend> wordCountTrends = new();

    private int totalEntries = 0;
    private double averageWordCount = 0;
    private int totalWords = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!SecurityService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAnalytics();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderCharts();
        }
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Load all analytics data
            streakInfo = await StreakService.GetStreakInfoAsync();
            moodDistribution = await AnalyticsService.GetMoodDistributionAsync(startDate, endDate);
            frequentMoods = await AnalyticsService.GetMostFrequentMoodsAsync(5, startDate, endDate);
            mostUsedTags = await AnalyticsService.GetMostUsedTagsAsync(10, startDate, endDate);
            wordCountTrends = await AnalyticsService.GetWordCountTrendsAsync(startDate, endDate);

            totalEntries = await AnalyticsService.GetEntriesCountAsync(startDate, endDate);
            averageWordCount = await AnalyticsService.GetAverageWordCountAsync(startDate, endDate);
            totalWords = await AnalyticsService.GetTotalWordCountAsync(startDate, endDate);

            isLoading = false;
            StateHasChanged();

            // Render charts after data is loaded
            await Task.Delay(100);
            await RenderCharts();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading analytics: {ex.Message}");
            isLoading = false;
        }
    }

    private async Task ResetDateRange()
    {
        startDate = null;
        endDate = null;
        await LoadAnalytics();
    }

    private async Task ExportData(string format)
    {
        exportMessage = string.Empty;
        isExporting = true;

        try
        {
            // Use Downloads folder
            var downloadsPath = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
            downloadsPath = Path.Combine(downloadsPath, "Downloads");

            if (!Directory.Exists(downloadsPath))
            {
                Directory.CreateDirectory(downloadsPath);
            }

            // Use the same date range filter from analytics
            var exportStartDate = startDate ?? DateTime.MinValue;
            var exportEndDate = endDate ?? DateTime.MaxValue;

            string filePath = string.Empty;

            switch (format.ToLower())
            {
                case "pdf":
                    filePath = await ExportService.ExportToPdfAsync(exportStartDate, exportEndDate, downloadsPath);
                    break;
                case "markdown":
                    filePath = await ExportService.ExportToMarkdownAsync(exportStartDate, exportEndDate, downloadsPath);
                    break;
                case "text":
                    filePath = await ExportService.ExportToTextAsync(exportStartDate, exportEndDate, downloadsPath);
                    break;
            }

            if (!string.IsNullOrEmpty(filePath))
            {
                exportMessage = $"✅ Exported successfully! File saved to Downloads folder.";

                // Open the downloads folder
                try
                {
                    System.Diagnostics.Process.Start("explorer.exe", downloadsPath);
                }
                catch { }
            }
            else
            {
                exportMessage = "⚠️ No entries found in the selected date range";
            }
        }
        catch (Exception ex)
        {
            exportMessage = $"❌ Export failed: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Export error: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task RenderCharts()
    {
        try
        {
            // Mood Distribution Chart
            if (moodDistribution.Any())
            {
                await JSRuntime.InvokeVoidAsync("renderMoodDistributionChart",
                    moodDistribution.Select(m => m.Category).ToArray(),
                    moodDistribution.Select(m => m.Count).ToArray());
            }

            // Frequent Moods Chart
            if (frequentMoods.Any())
            {
                await JSRuntime.InvokeVoidAsync("renderFrequentMoodsChart",
                    frequentMoods.Select(m => m.MoodName).ToArray(),
                    frequentMoods.Select(m => m.Count).ToArray());
            }

            // Tags Chart
            if (mostUsedTags.Any())
            {
                await JSRuntime.InvokeVoidAsync("renderTagsChart",
                    mostUsedTags.Select(t => t.TagName).ToArray(),
                    mostUsedTags.Select(t => t.Count).ToArray());
            }

            // Word Count Chart
            if (wordCountTrends.Any())
            {
                await JSRuntime.InvokeVoidAsync("renderWordCountChart",
                    wordCountTrends.Select(w => w.Date.ToString("MMM dd")).ToArray(),
                    wordCountTrends.Select(w => w.WordCount).ToArray(),
                    wordCountTrends.Select(w => w.AverageWordCount).ToArray());
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error rendering charts: {ex.Message}");
        }
    }
}