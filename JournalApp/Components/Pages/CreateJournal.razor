@page "/create"

<div class="create-wrapper">
    <div class="create-card">
        <h2 class="create-title">Create Journal</h2>

        <div class="form">
            <label>Journal Title</label>
            <input placeholder="Journal Title" />

            <label>Date</label>
            <input type="date" />

            <label>Journal Content</label>
            <textarea placeholder="Write your journal here..."></textarea>

            <label>Mood</label>
            <select>
                <option>Happy</option>
                <option>Sad</option>
                <option>Angry</option>
            </select>

            <label>Tag</label>
            <select>
                <option>Work</option>
                <option>Study</option>
            </select>

            <button class="btn">Save Journal</button>
        </div>
    </div>
</div>