@page "/"

<h2 class="page-title">My Journals</h2>

<div class="journal-grid">
    <div class="journal-card">
        <h4 class="journal-title">Good Day</h4>
        <p class="journal-text">
            Feeling productive and happy today 😊
        </p>

        <div class="journal-meta">
            <span class="badge tag">Work</span>
            <span class="badge mood happy">Happy</span>
        </div>
    </div>

    <div class="journal-card">
        <h4 class="journal-title">Exams Stress</h4>
        <p class="journal-text">
            A bit stressed with upcoming exams 😔
        </p>

        <div class="journal-meta">
            <span class="badge tag">Study</span>
            <span class="badge mood sad">Sad</span>
        </div>
    </div>
</div>
